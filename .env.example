# Credenciais do Instagram
INSTAGRAM_USERNAME=seu_usuario
INSTAGRAM_PASSWORD=sua_senha

# Perfil alvo (de quem você quer seguir os seguidores)
TARGET_PROFILE=perfil_alvo

# Configurações de segurança
MAX_FOLLOWS_PER_SESSION=20
MIN_DELAY_SECONDS=3
MAX_DELAY_SECONDS=8

# Modo headless (true = sem abrir navegador visível)
HEADLESS=false
